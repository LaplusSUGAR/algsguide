# node setup.mjs creates .env with a generated administrator password hash.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_PASSWORD_HASH=
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_BUDGET=90
YOUTUBE_POLL_MINUTES=30
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_MAX_PAGES=20
X_BEARER_TOKEN=
# Optional IDs returned by the official seasons/structure endpoint.
# Empty values select the main season and most recently started published event.
EA_SEASON_ID=
EA_EVENT_APAC_NORTH=
EA_EVENT_GLOBAL=
EA_EVENT_AMERICAS=
EA_EVENT_EMEA=
EA_EVENT_APAC_SOUTH=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Example format: mailto:your-real-contact@example.com (replace with your own contact)
VAPID_SUBJECT=
# Set ONLY when a known reverse proxy is in use; otherwise leave blank.
TRUSTED_PROXY_IP=
